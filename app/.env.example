# Conexão com o Postgres do Supabase (driver asyncpg).
# O host direto db.<projeto>.supabase.co resolve só em IPv6. Sem IPv6 na rede,
# use o pooler (Dashboard > Connect > Session pooler), que atende IPv4:
#   postgresql+asyncpg://postgres.<projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:<senha>@db.<projeto>.supabase.co:5432/postgres

# Supabase — obrigatório: é daqui que sai o JWKS usado para validar os tokens.
SUPABASE_URL=https://<projeto>.supabase.co

# Service role key — bypassa RLS. Nunca enviar ao app, nunca logar.
SUPABASE_SERVICE_KEY=<service-role-key>

# Só para projetos LEGADOS que ainda assinam em HS256.
# Projetos novos usam chave assimétrica (ES256) e são validados via JWKS —
# deixe vazio. O "Key ID" (um UUID) NÃO é um segredo de assinatura.
# SUPABASE_JWT_SECRET=<jwt-secret-hs256>

# CORS só afeta navegador (Expo Web); app nativo ignora. "*" libera em dev,
# em produção liste as origens web reais (separadas por vírgula).
CORS_ORIGINS=*

# Chave AES-256 (32 bytes, base64) para cifrar CPF/CNPJ antes de gravar em
# sellers_private.document_enc (ver core/crypto.py). Só é lida quando
# PUT /sellers/me/document é chamado — gere com:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
DOCUMENT_ENCRYPTION_KEY=<chave-base64-de-32-bytes>
